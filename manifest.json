{
  "manifest_version": 3,
  "name": "斗內預算管家",
  "version": "0.1.1",
  "description": "整理 HiveBee / YouTube / Twitch 的贊助紀錄，依直播主與總額設定每月上限。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://www.hivebee.com.tw/*",
    "https://hivebee.com.tw/*",
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*",
    "https://pay.google.com/*",
    "https://payments.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/gpay.js"
      ],
      "matches": [
        "https://payments.google.com/*"
      ]
    }
  ]
}
